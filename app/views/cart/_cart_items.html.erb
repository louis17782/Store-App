<% currency = session[:currency] || "usd" %>

<div id="cart-items">
  <% total = 0 %>
  <% @items.each do |item| %>
  <% product = item.product %>
  <div class="cart-item">
    <strong><%= product.name %></strong>
    <p>Stock disponible: <%= product.quantity %></p>
    <div class="content-quantity">
      <span> Cantidad: </span>
      <%= form_with url: cart_decrease_path(item.id), method: :post, class: "inline-form", data: { turbo_stream: true } do %>
      <button class="qty-btn">-</button>
      <% end %>

      <span class="qty-number"><%= item.quantity %></span>

      <%= form_with url: cart_increase_path(item.id), method: :post, class: "inline-form", data: { turbo_stream: true } do %>
        <button class="qty-btn">+</button>
      <% end %>

      <%= form_with url: cart_remove_path(item.id), method: :delete, data: { turbo_stream: true }, class: "inline-form" do %>
        <button class="delete-icon-btn">
          <i class="ph ph-trash"></i>
        </button>
      <% end %>
    </div>
    <% price = currency == "bs" ? product.price_bs : product.price_usd %>
    <p> Precio unitario:
      <%= currency == "bs" ? "Bs" : "$" %><%= price %>
    </p>
    <% subtotal = price * item.quantity %>
   
    <% total += subtotal %>
  </div>
  <% end %>
  <div class="content-button">
    <h4>Total: <%= currency == "bs" ? "Bs" : "$" %><%= total %></h4>
    <%= link_to "Finalizar compra", checkout_path, method: :post, class: "btn-store" %>
  </div>
</div>
